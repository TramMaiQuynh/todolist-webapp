DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SSL_REDIRECT=false
DJANGO_SECURE_COOKIES=false
DJANGO_HSTS_SECONDS=0
# Enable only when every subdomain uses HTTPS and the domain is eligible for HSTS preload.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
TIME_ZONE=Asia/Ho_Chi_Minh
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080
AUTH_TOKEN_TTL_DAYS=14

POSTGRES_DB=todolist
POSTGRES_USER=todolist
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Optional for a frontend served from a separate origin. Leave unset to use /api/v1.
# VITE_API_URL=https://api.example.com/api/v1
